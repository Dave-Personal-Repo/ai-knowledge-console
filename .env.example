# Copy to .env to override Compose defaults. Never commit .env.
KCONSOLE_PORT=4310
KCONSOLE_BIND_IP=127.0.0.1
KB_IDENTITY=dave-bfi
TZ=UTC

# Windows examples (use forward slashes in Compose paths):
# KCONSOLE_HOST_HOME=C:/Users/you
# KCONSOLE_GH_CONFIG=C:/Users/you/.config/gh
# KCONSOLE_KB_STATE=C:/Users/you/AppData/Local/kb
# KB_BIN=C:/tools/kb.cmd

# Required for durable access: put this in .secret/credentials.env (gitignored)
# GH_TOKEN=<paste-token>
